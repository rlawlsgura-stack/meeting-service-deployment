# 프로젝트 루트 .env에 필요한 값만 입력한다. 실제 .env는 Git·이미지에 넣지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# 기존 Supabase 프로젝트의 PostgreSQL 연결과 Auth 중계 설정이다.
# 컨테이너에서 연결 가능한 Connect 화면의 연결값을 사용한다.
# 비밀번호의 특수문자는 URL 인코딩하고 sslmode=require를 지정한다.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 선택한 실행만 추적할 때 사용한다. 키가 없으면 false를 유지한다.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=meeting-service

# 표시용 실행 버전이다. 실제 소스·이미지 식별자를 대신하지 않는다.
APP_VERSION=local-v1
